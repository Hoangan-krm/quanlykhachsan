# ============================================================
# Hotel Management System — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
# Base URL dùng trong link email (xác thực tài khoản, khôi phục mật khẩu)
APP_BASE_URL=http://localhost:3000

# --- Database (MySQL 8.0) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hotel_db

# --- JWT Authentication ---
# Bắt buộc trong production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here
JWT_EXPIRES_IN_STAFF=8h
JWT_EXPIRES_IN_CUSTOMER=2h

# --- Password Hashing ---
BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Online payment (US-40) — Stripe, PCI-DSS delegated ---
# Lấy key tại dashboard.stripe.com (test mode cho dev). Khi bỏ trống,
# endpoint thanh toán online trả 503 PAYMENT_GATEWAY_UNAVAILABLE.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://localhost:3000/#/customer/bookings

# --- Email (US-4, US-35, US-41) — SMTP; bỏ trống để chỉ ghi log email (dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hoangan-hotel.example

# --- Backup (US-34) ---
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_MS=86400000
STRIPE_PUBLISHABLE_KEY=
